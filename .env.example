# Copy to .env. Every variable is validated at boot (src/config/env.schema.ts).
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5175,http://localhost:5176,http://localhost:8081

MONGODB_URI=mongodb://localhost:27017/emergency-tracka
REDIS_URL=redis://localhost:6379

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-0000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

OTP_TTL_SECONDS=300
# Dev only: include the code in the /auth/otp/request response. Refused at boot in production.
OTP_DEV_ECHO=false

# Timers (seconds). Defaults follow architecture §2.3.
WAVE_TIMEOUT_CRITICAL_SECONDS=180
WAVE_TIMEOUT_DEFAULT_SECONDS=600
MATRON_AUTO_CONFIRM_SECONDS=180
RECONCILIATION_INTERVAL_SECONDS=60

# 'when_present' = enforce only once a facility has a roster for the week; 'strict' = always.
ROSTER_ENFORCEMENT=when_present

# Feature flags
FEATURE_BLOOD=false

# Paystack (optional for local dev — payments init will fail without it; webhooks are refused).
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5175/pay/complete
# Static-IP payment proxy (architecture §4). Leave blank to call api.paystack.co directly.
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# Sign-in codes by email (alongside SMS). Leave SMTP_HOST blank to log them to the console.
# 465 = implicit TLS; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Emergency Tracka <noreply@example.com>"
